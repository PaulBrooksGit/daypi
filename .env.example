# DayPI Phase 0 — local development only. Never put live child data here.
# Pin: Node >=20, PostgreSQL 16.

NODE_ENV=development
PORT=3001

# Application DB role (no BYPASSRLS, not table owner)
DATABASE_URL=postgresql://daypi_app:daypi_app_dev@127.0.0.1:5432/daypi

# Migrator / owner role (migrations and privileged maintenance only)
MIGRATION_DATABASE_URL=postgresql://daypi_migrator:daypi_migrator_dev@127.0.0.1:5432/daypi

# Integration tests use a separate database
TEST_DATABASE_URL=postgresql://daypi_app:daypi_app_dev@127.0.0.1:5432/daypi_test
TEST_MIGRATION_DATABASE_URL=postgresql://daypi_migrator:daypi_migrator_dev@127.0.0.1:5432/daypi_test

SESSION_SECRET=dev-only-change-me-to-a-long-random-string
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
ALLOWED_HOSTS=localhost,127.0.0.1

# Feature gates (D01–D12) — keep consequential features off
FEATURE_LIVE_BILLING=false
FEATURE_PROMOTIONAL_GRANTS=false
FEATURE_STRIPE_LIVE=false
FEATURE_PAYROLL_LIVE=false
FEATURE_AI_CONSEQUENTIAL=false
FEATURE_OFFLINE_COMPLETION=false
FEATURE_TRIP_GPS_LIVE=false
FEATURE_MARKETPLACE_LIVE=false
FEATURE_DAYSWAP=false
FEATURE_DAYSALE=false
FEATURE_SUPPORT_BREAK_GLASS=false

# Storage (local stub by default; S3-compatible later)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.data/storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Upload limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png,text/plain

LOG_LEVEL=info
