[Unit]
Description=DayPI DayPush worker
After=network.target postgresql.service daypi-api.service
Wants=postgresql.service

[Service]
Type=simple
User=daypi
WorkingDirectory=/opt/daypi/app
EnvironmentFile=/opt/daypi/.env
ExecStart=/usr/bin/npm run start:worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
