# DayPI Hostinger / production-like pilot — TEMPLATE ONLY
# Copy to the host as /opt/daypi/.env (mode 0600). Never commit real secrets.
# Source checklist mirrors root .env.example; values here are placeholders.

NODE_ENV=production
PORT=3001

# Application DB role (no BYPASSRLS, not table owner)
DATABASE_URL=postgresql://daypi_app:CHANGE_ME_APP@127.0.0.1:5432/daypi

# Migrator / owner role (migrations only)
MIGRATION_DATABASE_URL=postgresql://daypi_migrator:CHANGE_ME_MIGRATOR@127.0.0.1:5432/daypi

# Not used on the VPS for normal runtime; keep for parity with local/CI if needed
# TEST_DATABASE_URL=
# TEST_MIGRATION_DATABASE_URL=

# Generate on host: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET
COOKIE_SECURE=true
CORS_ORIGINS=https://app.example.invalid
TRUSTED_PROXIES=127.0.0.1
ALLOWED_HOSTS=api.example.invalid

# Feature gates (D01–D12) — pilot prep: keep consequential features off
FEATURE_LIVE_BILLING=false
FEATURE_PROMOTIONAL_GRANTS=false
FEATURE_STRIPE_LIVE=false
FEATURE_PAYROLL_LIVE=false
FEATURE_AI_CONSEQUENTIAL=false
FEATURE_OFFLINE_COMPLETION=false
FEATURE_TRIP_GPS_LIVE=false
FEATURE_MARKETPLACE_LIVE=false
FEATURE_DAYSWAP=false
FEATURE_DAYSALE=false
FEATURE_SUPPORT_BREAK_GLASS=false

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/opt/daypi/data/storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png,text/plain

# Sandbox webhook HMAC secrets (optional). Empty = unsigned sandbox payloads accepted
# while FEATURE_STRIPE_LIVE remains false. Do not put live provider secrets here for pilot.
STRIPE_WEBHOOK_SECRET=
TWILIO_WEBHOOK_SECRET=

LOG_LEVEL=info

# Redis: not used by DayPI today (Postgres outbox). No REDIS_* vars.
