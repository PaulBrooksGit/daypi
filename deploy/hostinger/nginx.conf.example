# Example nginx reverse proxy for DayPI API (TLS via certbot separately).
# Replace api.example.invalid — final hostnames are Pending (D02).

upstream daypi_api {
	server 127.0.0.1:3001;
	keepalive 32;
}

server {
	listen 443 ssl http2;
	server_name api.example.invalid;

	# ssl_certificate     /etc/letsencrypt/live/api.example.invalid/fullchain.pem;
	# ssl_certificate_key /etc/letsencrypt/live/api.example.invalid/privkey.pem;

	client_max_body_size 12m;

	location / {
		proxy_pass http://daypi_api;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Connection "";
	}
}

server {
	listen 80;
	server_name api.example.invalid;
	return 301 https://$host$request_uri;
}
